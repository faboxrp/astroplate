---
import { markdownify } from "@/lib/utils/textConverter";
import ImageMod from "@/components/ImageMod.astro";
const { testimonial } = Astro.props;

interface TestimonialItem {
  avatar?: string; // Hecho opcional aquí también para que coincida con el schema
  content: string;
  name: string;
  designation: string;
  image_before?: string; // Nuevo campo
  image_after?: string; // Nuevo campo
}
---

{
  testimonial.data.enable && (
    <section class="section">
      <div class="container">
        <div class="row">
          <div class="mx-auto mb-12 text-center md:col-10 lg:col-8 xl:col-6">
            <h2 set:html={markdownify(testimonial.data.title)} class="mb-4" />
            <p set:html={markdownify(testimonial.data.description)} />
          </div>
          <div class="col-12">
            <div class="swiper testimonial-slider">
              <div class="swiper-wrapper">
                {testimonial.data.testimonials.map((item: TestimonialItem) => (
                  <div class="swiper-slide h-auto">
                    {" "}
                    {/* Añadido h-auto para que el alto se ajuste al contenido */}
                    <div class="flex flex-col h-full rounded-lg bg-light p-7 dark:bg-darkmode-light">
                      {" "}
                      {/* flex flex-col h-full para que el contenido ocupe todo el alto */}
                      <div class="text-primary dark:text-darkmode-primary">
                        {" "}
                        {/* Usando color primario para la cita */}
                        <svg width="33" height="20" viewBox="0 0 33 20" fill="none" xmlns="http://www.w3.org/2000/svg" class="opacity-50">
                          <path
                            d="M1.28375 19.41L0.79375 18.64C1.21375 17.0067 1.75042 15.07 2.40375 12.83C3.05708 10.5433 3.75708 8.28 4.50375 6.04C5.29708 3.75333 6.06708 1.77 6.81375 0.0899959H15.3538C14.9338 2.09666 14.4904 4.26667 14.0238 6.6C13.5571 8.88666 13.1371 11.15 12.7638 13.39C12.4371 15.5833 12.1571 17.59 11.9238 19.41H1.28375ZM31.69 0.0899959L32.18 0.859998C31.76 2.54 31.2233 4.5 30.57 6.74C29.9167 8.98 29.2167 11.2433 28.47 13.53C27.7233 15.77 26.9533 17.73 26.16 19.41H17.69C18.0167 17.9167 18.3433 16.33 18.67 14.65C18.9967 12.9233 19.3 11.22 19.58 9.54C19.9067 7.81333 20.1867 6.15667 20.42 4.57C20.7 2.93666 20.91 1.44333 21.05 0.0899959H31.69Z"
                            fill="currentColor"
                          />
                        </svg>
                      </div>
                      <blockquote class="mt-8 flex-grow" set:html={markdownify(item.content)} />
                      {item.image_before && item.image_after && (
                        <div class="mt-6 grid grid-cols-2 gap-4">
                          <div>
                            <p class="text-sm font-semibold text-center mb-1 text-text">Antes</p>
                            <ImageMod class="rounded" src={item.image_before} alt={`Antes - ${item.name}`} width={200} height={200} format="webp" />
                          </div>
                          <div>
                            <p class="text-sm font-semibold text-center mb-1 text-text">Después</p>
                            <ImageMod class="rounded" src={item.image_after} alt={`Después - ${item.name}`} width={200} height={200} format="webp" />
                          </div>
                        </div>
                      )}
                      <div class="mt-auto pt-6 flex items-center">
                        {" "}
                        {/* mt-auto y pt-6 para empujar esto al final si hay espacio */}
                        {item.avatar && (
                          <div class="flex-shrink-0">
                            {" "}
                            {/* Evita que el avatar se encoja */}
                            <ImageMod height={50} width={50} class="rounded-full" src={item.avatar} alt={item.name} format="webp" />
                          </div>
                        )}
                        <div class={item.avatar ? "ml-4" : ""}>
                          <h3 set:text={item.name} class="h5 font-primary font-semibold" />
                          <p set:text={item.designation} class="text-text-light" />
                        </div>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
              <div class="testimonial-slider-pagination mt-9 flex items-center justify-center text-center" />
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}

<script>
  import { Swiper } from "swiper";
  import "swiper/css";
  import "swiper/css/pagination";
  import { Autoplay, Pagination } from "swiper/modules";

  document.addEventListener("astro:page-load", () => {
    // Asegúrate de que no se inicialice múltiples veces si ya existe
    if (document.querySelector(".testimonial-slider.swiper-initialized")) {
      return;
    }

    new Swiper(".testimonial-slider", {
      modules: [Pagination, Autoplay],
      spaceBetween: 24,
      loop: true,
      // centeredSlides: true, // Puede ser true o false dependiendo de cuántos slides quieras ver parcialmente
      slidesPerView: 1, // Empezar con 1 para móviles
      autoplay: {
        delay: 8000, // Un poco más de tiempo
        disableOnInteraction: false,
      },
      pagination: {
        el: ".testimonial-slider-pagination",
        type: "bullets",
        clickable: true,
      },
      breakpoints: {
        768: {
          // md
          slidesPerView: 2,
          // centeredSlides: false, // Opcional, si son 2 exactos
        },
        1024: {
          // lg
          slidesPerView: 3,
          // centeredSlides: false, // Opcional, si son 3 exactos
        },
      },
    });
  });
</script>
