---
import { markdownify } from "@/lib/utils/textConverter";

export interface Props {
  title: string;
  intro?: string;
}

const { title, intro } = Astro.props;
---

<section class="page-header pt-16 pb-28">
  <div class="container">
    <div class="row justify-center">
      <div class="lg:col-8 text-center">
        <h1 class="text-h1 font-bold text-primary dark:text-darkmode-primary leading-tight" set:html={markdownify(title)} />
        {intro && (
          <div class="mt-6">
            <p class="text-xl text-primary dark:text-darkmode-light leading-relaxed" set:html={markdownify(intro)} />
          </div>
        )}
      </div>
    </div>
  </div>
</section>
