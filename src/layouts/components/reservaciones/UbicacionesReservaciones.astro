---
// src/layouts/components/reservaciones/UbicacionesReservaciones.astro
import { Icon } from "astro-iconify";

interface Location {
  name: string;
  address: string;
  map_embed_code?: string;
  opening_hours?: string[];
}

interface Props {
  data: {
    locations?: Location[];
    full_address?: string;
    phone_number?: string;
    phone_number_display?: string;
    whatsapp_number?: string;
    whatsapp_text?: string;
    email_address?: string;
    opening_hours?: string[];
    map_embed_code?: string;
  };
}
const { data } = Astro.props;
---

<section class="relative isolate overflow-hidden">
  <div class="container relative">
    <!-- Nuestras Ubicaciones -->
    {
      data.locations && data.locations.length > 0 && (
        <div>
          <div class="flex flex-col lg:grid lg:grid-cols-2 gap-8">
            {data.locations.map((location, index) => (
              <div class="space-y-6">
                {/* Botón de reservación con Cal.com - Fuera del recuadro */}
                <div class="text-center">
                  <button
                    data-cal-namespace={location.name.toLowerCase().replace("á", "a").replace("ó", "o")}
                    data-cal-link={`orthopure.ec/${location.name.toLowerCase().replace("á", "a").replace("ó", "o")}`}
                    data-cal-config='{"layout":"month_view"}'
                    class="reservation-btn group relative inline-flex items-center justify-center px-8 py-4 bg-gradient-to-r from-purple-800 to-purple-600 dark:from-purple-700 dark:to-purple-500 text-white font-bold text-lg rounded-2xl shadow-lg transform transition-all duration-300 hover:scale-105 hover:shadow-2xl active:scale-95 overflow-hidden">
                    {/* Animated background */}
                    <div class="absolute inset-0 bg-gradient-to-r from-purple-600 to-purple-800 dark:from-purple-500 dark:to-purple-700 opacity-0 group-hover:opacity-100 transition-opacity duration-300" />

                    {/* Pulse animation */}
                    <div class="absolute inset-0 rounded-2xl bg-white opacity-10 animate-pulse group-hover:animate-none" />

                    {/* Content */}
                    <div class="relative flex items-center z-10">
                      <Icon name="mdi:calendar-plus" class="h-6 w-6 mr-3 group-hover:animate-bounce" />
                      <span class="group-hover:tracking-wider transition-all duration-300">Reservar Cita en {location.name}</span>
                    </div>

                    {/* Shine effect */}
                    <div class="absolute top-0 left-[-100%] w-full h-full bg-gradient-to-r from-transparent via-white/20 to-transparent group-hover:left-[100%] transition-all duration-700 ease-out" />
                  </button>
                </div>

                {/* Información de la ubicación */}
                <div class="bg-white dark:bg-darkmode-body p-6 rounded-lg shadow-md border border-gray-200 dark:border-gray-700 hover:shadow-lg transition-shadow duration-300">
                  <div class="flex items-start mb-4">
                    <Icon name="mdi:map-marker-outline" class="h-6 w-6 mr-3 mt-1 text-primary dark:text-darkmode-primary flex-shrink-0" />
                    <div>
                      <h3 class="font-semibold text-xl text-primary dark:text-darkmode-primary mb-2">{location.name}</h3>
                      <div class="text-gray-700 dark:text-gray-300 whitespace-pre-line">{location.address}</div>
                    </div>
                  </div>

                  {/* Horarios específicos por ubicación */}
                  {location.opening_hours && location.opening_hours.length > 0 && (
                    <div class="mb-6">
                      <h4 class="font-semibold text-base text-gray-800 dark:text-gray-200 mb-3">Horario de Atención</h4>
                      <ul class="space-y-1">
                        {location.opening_hours.map((line) => (
                          <li class="flex items-center text-sm text-gray-600 dark:text-gray-400">
                            <Icon name="mdi:clock-outline" class="h-4 w-4 mr-2" />
                            {line}
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}

                  {/* Mapa */}
                  {location.map_embed_code && (
                    <div class="mt-4">
                      <div class="aspect-w-16 aspect-h-9 map-responsive">
                        <Fragment set:html={location.map_embed_code} />
                      </div>
                    </div>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      )
    }
  </div>
</section>

<!-- Cal.com Script para Ibarra -->
<script type="text/javascript">
  (function (C, A, L) {
    let p = function (a, ar) {
      a.q.push(ar);
    };
    let d = C.document;
    C.Cal =
      C.Cal ||
      function () {
        let cal = C.Cal;
        let ar = arguments;
        if (!cal.loaded) {
          cal.ns = {};
          cal.q = cal.q || [];
          d.head.appendChild(d.createElement("script")).src = A;
          cal.loaded = true;
        }
        if (ar[0] === L) {
          const api = function () {
            p(api, arguments);
          };
          const namespace = ar[1];
          api.q = api.q || [];
          if (typeof namespace === "string") {
            cal.ns[namespace] = cal.ns[namespace] || api;
            p(cal.ns[namespace], ar);
            p(cal, ["initNamespace", namespace]);
          } else p(cal, ar);
          return;
        }
        p(cal, ar);
      };
  })(window, "https://app.cal.com/embed/embed.js", "init");

  Cal("init", "ibarra", { origin: "https://app.cal.com" });
  Cal.ns.ibarra("ui", {
    cssVarsPerTheme: {
      light: { "cal-brand": "#5b1885" },
      dark: { "cal-brand": "#F791EF" },
    },
    hideEventTypeDetails: false,
    layout: "month_view",
  });

  // Cal.com Script para Tulcan (sin tilde)
  Cal("init", "tulcan", { origin: "https://app.cal.com" });
  Cal.ns.tulcan("ui", {
    cssVarsPerTheme: {
      light: { "cal-brand": "#5b1885" },
      dark: { "cal-brand": "#F791EF" },
    },
    hideEventTypeDetails: false,
    layout: "month_view",
  });
</script>

<style>
  .map-responsive {
    overflow: hidden;
    padding-bottom: 56.25%;
    position: relative;
    height: 0;
    width: 100%;
  }
  .map-responsive iframe {
    left: 0;
    top: 0;
    height: 100%;
    width: 100%;
    position: absolute;
    border: 0;
  }

  /* Animaciones adicionales para los botones */
  .reservation-btn {
    position: relative;
    background-size: 200% 200%;
    animation: gradient-shift 3s ease infinite;
  }

  @keyframes gradient-shift {
    0%,
    100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }
</style>
