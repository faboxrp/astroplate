---
// src/layouts/components/contacto/FormularioContacto.astro
interface Props {
  action: string;
}
const { action } = Astro.props;
---

<div class="lg:col-6">
  <h2 class="h3 mb-6 font-semibold">Envíanos un Mensaje</h2>
  <form action={action} method="POST" id="contact-form">
    <div class="mb-6">
      <label for="name" class="form-label text-primary dark:text-darkmode-primary">
        Nombre Completo <span class="text-red-500">*</span>
      </label>
      <input id="name" name="name" class="form-input" placeholder="Ej: María Pérez" type="text" required />
    </div>
    <div class="mb-6">
      <label for="email" class="form-label text-primary dark:text-darkmode-primary">
        Correo Electrónico <span class="text-red-500">*</span>
      </label>
      <input id="email" name="email" class="form-input" placeholder="Ej: maria.perez@correo.com" type="email" required />
    </div>
    <div class="mb-6">
      <label for="phone" class="form-label text-primary dark:text-darkmode-primary"> Teléfono (Opcional) </label>
      <input id="phone" name="phone" class="form-input" placeholder="Ej: 0991234567" type="tel" />
    </div>
    <div class="mb-6">
      <label for="message" class="form-label text-primary dark:text-darkmode-primary">
        Tu Mensaje <span class="text-red-500">*</span>
      </label>
      <textarea id="message" name="message" class="form-input" placeholder="Escribe aquí tu consulta..." rows="6" required></textarea>
    </div>
    <button type="submit" class="btn btn-primary mb-4" style="cursor: pointer;">Enviar Mensaje</button>
  </form>
</div>

<script>
  // Selecciona el formulario por su ID
  const form = document.getElementById("contact-form") as HTMLFormElement | null;

  // Añade un "escuchador" para el evento de envío
  if (form) {
    form.addEventListener("submit", async function (event) {
      // 1. Previene el comportamiento por defecto del navegador (que es redirigir)
      event.preventDefault();

      // 2. Recolecta los datos del formulario
      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries());

      // Opcional: Muestra un estado de "cargando" en el botón
      const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      if (submitButton) {
        submitButton.disabled = true;
        submitButton.textContent = "Enviando...";
      }

      try {
        // 3. Envía los datos a tu webhook de n8n
        const response = await fetch(form.action, {
          method: "POST",
          body: JSON.stringify(data),
          headers: {
            "Content-Type": "application/json",
          },
        });

        if (response.ok) {
          // 4. Si el envío fue exitoso, redirige a la página de éxito
          window.location.href = "/contacto/exito";
        } else {
          // Maneja el caso de que n8n devuelva un error
          alert("Hubo un error al enviar el mensaje. Por favor, inténtalo de nuevo.");
          if (submitButton) {
            submitButton.disabled = false;
            submitButton.textContent = "Enviar Mensaje";
          }
        }
      } catch (error) {
        // Maneja errores de red
        console.error("Error de red:", error);
        alert("No se pudo conectar con el servidor. Revisa tu conexión a internet.");
        if (submitButton) {
          submitButton.disabled = false;
          submitButton.textContent = "Enviar Mensaje";
        }
      }
    });
  }
</script>
