---
import { markdownify } from "@/lib/utils/textConverter";

const faqItems = [
  {
    question: "¿Por qué me duelen los dientes después del control?",
    answer:
      "Es normal sentir molestias después de los ajustes. Esto indica que el tratamiento está funcionando y los dientes se están moviendo hacia su posición correcta.",
    blogLink: "/blog/dolor-despues-control-ortodoncia",
    id: "dolor-control",
    icon: "tooth-pain" // Ícono de dolor dental
  },
  {
    question: "¿Cuánto tiempo duran las molestias después de mi control?",
    answer: "Las molestias suelen durar entre 2 a 5 días después del ajuste. El dolor disminuye gradualmente con cada cita.",
    blogLink: "/blog/duracion-molestias-ortodoncia",
    id: "duracion-molestias",
    icon: "clock" // Ícono de tiempo
  },
  {
    question: "¿Qué hago si se me sale un bracket?",
    answer: "Mantén la calma y contacta inmediatamente con nuestra clínica. Guarda el bracket y evita alimentos duros hasta tu cita de emergencia.",
    blogLink: "/blog/bracket-despegado-que-hacer",
    id: "bracket-despegado",
    icon: "alert-triangle" // Ícono de emergencia
  },
  {
    question: "¿Puedo ir con otro dentista si se me cae un bracket?",
    answer:
      "Es recomendable que tu ortodoncista de confianza sea quien coloque el bracket, ya que conoce tu plan de tratamiento específico. Otro doctor no tiene tu plan de tratamiento y podría cometer muchos errores.",
    blogLink: "/blog/otro-dentista-bracket-riesgos",
    id: "otro-doctor-bracket",
    icon: "user-check" // Ícono de profesional
  },
  {
    question: "¿Cuánto tiempo dura mi tratamiento?",
    answer:
      "La duración varía según cada caso, pero generalmente oscila entre 18 meses a 2 años para casos complejos. Te daremos un estimado personalizado en tu consulta.",
    blogLink: "/blog/duracion-tratamiento-ortodoncia",
    id: "duracion-tratamiento",
    icon: "calendar" // Ícono de calendario
  },
  {
    question: "¿Me van a sacar algún diente para mi tratamiento de ortodoncia?",
    answer: "Solo si es necesario. Si los dientes están muy montados, es probable que sí. Si no están tan apretados, probablemente no será necesario.",
    blogLink: "/blog/extracciones-dentales-ortodoncia",
    id: "extracciones-dentales",
    icon: "scissors" // Ícono de extracción
  },
];

// Función para obtener el ícono SVG basado en el tipo
type IconType = "tooth-pain" | "clock" | "alert-triangle" | "user-check" | "calendar" | "scissors";
const getIconSVG = (iconType: string) => {
  const icons: Record<IconType, string> = {
    "tooth-pain": `<svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5l-6.928-7.5c-.768-.833-2.036-.833-2.804 0l-6.928 7.5c-.77.833.192 2.5 1.732 2.5z" />
    </svg>`,
    "clock": `<svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>`,
    "alert-triangle": `<svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5l-6.928-7.5c-.768-.833-2.036-.833-2.804 0l-6.928 7.5c-.77.833.192 2.5 1.732 2.5z" />
    </svg>`,
    "user-check": `<svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
    </svg>`,
    "calendar": `<svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
    </svg>`,
    "scissors": `<svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h1m4 0h1m-6.414-4.414a4 4 0 015.656 0L12 7.414l1.758-1.758a4 4 0 015.656 0L12 13.172l-7.414-7.414z" />
    </svg>`
  };
  return icons[iconType as IconType] || icons["alert-triangle"];
};
---

<section data-component="faq" class="relative isolate overflow-hidden py-24 bg-gradient-to-br from-primary/5 to-transparent">
  <div class="container relative space-y-12">
    <div class="text-center space-y-4">
      <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight fade-up section-title title-reveal">Preguntas Frecuentes</h2>
      <p class="text-lg text-muted-foreground max-w-2xl mx-auto fade-up" style="--delay:200ms">
        Resolvemos las dudas más comunes sobre tu tratamiento de ortodoncia
      </p>
    </div>

    <div class="max-w-4xl mx-auto space-y-4 faq-container">
      {
        faqItems.map((item, index) => (
          <div class="faq-item fade-up" style={`--delay:${(index + 2) * 150}ms; --item-index:${index}`}>
            <div class="faq-card bg-white dark:bg-darkmode-light rounded-xl shadow-sm border border-gray-100 dark:border-darkmode-border overflow-hidden transition-all duration-300 hover:shadow-lg hover:shadow-primary/10 hover:border-primary/20 hover:-translate-y-1">
              <button
                type="button"
                class="faq-trigger w-full px-6 py-5 text-left flex items-center gap-4 focus:outline-none focus:ring-2 focus:ring-primary/20 focus:ring-inset group"
                data-faq-trigger={item.id}
                aria-expanded="false"
                aria-controls={`faq-content-${item.id}`}>
                
                <!-- Ícono de la pregunta -->
                <div class="question-icon flex-shrink-0 p-2 bg-primary/10 rounded-lg transition-all duration-300 group-hover:bg-primary/20 group-hover:scale-110">
                  <div class="text-primary" set:html={getIconSVG(item.icon)}></div>
                </div>
                
                <!-- Pregunta -->
                <h3 class="text-lg font-medium text-text-dark dark:text-darkmode-text-dark flex-1 transition-colors duration-300 group-hover:text-primary">{item.question}</h3>
                
                <!-- Ícono de expansión -->
                <div class="faq-icon flex-shrink-0 transition-transform duration-300 group-hover:text-primary">
                  <svg class="h-5 w-5 text-gray-500 dark:text-darkmode-text" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </div>
              </button>

              <div
                id={`faq-content-${item.id}`}
                class="faq-content overflow-hidden transition-all duration-300 ease-out"
                style="max-height: 0px;"
                aria-labelledby={`faq-trigger-${item.id}`}>
                <div class="px-6 pb-6 pt-4 border-t border-gray-50 dark:border-darkmode-border/50 bg-gray-50/50 dark:bg-darkmode-body/30">
                  <p class="text-text dark:text-darkmode-text mb-6 leading-relaxed text-base">{item.answer}</p>
                  
                  <!-- Botón del blog -->
                  <a
                    href={item.blogLink}
                    class="btn btn-primary text-sm inline-flex items-center gap-2 hover:shadow-lg transform hover:-translate-y-0.5 transition-all duration-300">
                    
                    <!-- Ícono del blog -->
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                    </svg>
                    
                    <span>Leer artículo completo</span>
                    
                    <!-- Flecha animada -->
                    <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </a>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <style>
    /* ===== ANIMACIONES CSS PURAS AL CARGAR ===== */

    /* Título con reveal effect */
    .title-reveal {
      animation: titleReveal 1.2s cubic-bezier(0.4, 0, 0.2, 1) forwards;
      position: relative;
      overflow: hidden;
    }

    .title-reveal::before {
      content: "";
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, hsl(var(--primary) / 0.3), transparent);
      animation: titleSweep 1.5s ease-out 0.5s;
    }

    @keyframes titleReveal {
      from {
        opacity: 0;
        transform: translateY(50px) scale(0.9);
        filter: blur(10px);
      }
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
        filter: blur(0);
      }
    }

    @keyframes titleSweep {
      from {
        left: -100%;
      }
      to {
        left: 100%;
      }
    }

    /* ===== FAQ ITEMS ===== */
    .faq-item {
      position: relative;
      overflow: hidden;
    }

    /* Efectos mejorados para las tarjetas FAQ */
    .faq-card {
      position: relative;
      background: linear-gradient(135deg, hsl(var(--background)) 0%, hsl(var(--background) / 0.95) 100%);
      backdrop-filter: blur(10px);
      border: 1px solid hsl(var(--primary) / 0.1);
    }

    .faq-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 2px;
      background: linear-gradient(90deg, transparent, hsl(var(--primary) / 0.5), transparent);
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .faq-card:hover::before {
      opacity: 1;
    }

    /* Efectos hover para el trigger */
    .faq-trigger {
      position: relative;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .faq-trigger:hover {
      background: linear-gradient(135deg, hsl(var(--primary) / 0.05) 0%, hsl(var(--primary) / 0.02) 100%);
    }

    .faq-trigger[aria-expanded="true"] {
      background: linear-gradient(135deg, hsl(var(--primary) / 0.08) 0%, hsl(var(--primary) / 0.04) 100%);
      border-bottom: 1px solid hsl(var(--primary) / 0.1);
    }

    /* Animaciones para los iconos de preguntas */
    .question-icon {
      position: relative;
      overflow: hidden;
    }

    .question-icon::before {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      width: 0;
      height: 0;
      background: hsl(var(--primary) / 0.3);
      border-radius: 50%;
      transform: translate(-50%, -50%);
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .faq-trigger:hover .question-icon::before {
      width: 100%;
      height: 100%;
    }

    /* Efectos de pulso para iconos expandidos */
    .faq-trigger[aria-expanded="true"] .question-icon {
      animation: iconPulse 2s infinite;
    }

    @keyframes iconPulse {
      0%, 100% {
        box-shadow: 0 0 0 0 hsl(var(--primary) / 0.4);
      }
      50% {
        box-shadow: 0 0 0 8px hsl(var(--primary) / 0);
      }
    }

    .faq-content {
      transition:
        max-height 0.3s ease-out,
        opacity 0.3s ease-out;
      opacity: 0;
    }

    .faq-content.expanded {
      opacity: 1;
    }

    /* ===== ANIMACIONES CON VIEW TRANSITIONS ===== */
    @supports (animation-timeline: view()) {
      .section-title {
        animation: titleSlideView linear forwards;
        animation-timeline: view();
        animation-range: entry 0% entry 30%;
      }

      .faq-item {
        animation: faqSlideView linear forwards;
        animation-timeline: view();
        animation-range: entry 0% entry 40%;
        animation-delay: calc(var(--item-index) * 0.1s);
      }

      @keyframes titleSlideView {
        from {
          opacity: 0;
          transform: translateY(80px) scale(0.8);
        }
        to {
          opacity: 1;
          transform: translateY(0) scale(1);
        }
      }

      @keyframes faqSlideView {
        from {
          opacity: 0;
          transform: translateY(60px) scale(0.95);
        }
        to {
          opacity: 1;
          transform: translateY(0) scale(1);
        }
      }
    }

    /* ===== PLAN B - Animaciones JS ===== */
    .fade-up {
      opacity: 1;
    }

    @media (prefers-reduced-motion: no-preference) {
      .fade-up {
        opacity: 0;
        transform: translateY(24px);
      }
    }

    .fade-up.show {
      opacity: 1;
      transform: none;
      transition:
        opacity 0.6s ease-out,
        transform 0.6s ease-out;
      transition-delay: var(--delay, 0ms);
    }

    /* Fallback para navegadores sin soporte */
    @supports not (animation-timeline: view()) {
      .fade-up {
        opacity: 1;
      }
    }

    /* Efectos adicionales para el contenido expandido */
    .faq-content.expanded {
      animation: contentSlideIn 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    @keyframes contentSlideIn {
      from {
        opacity: 0;
        transform: translateY(-10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Efectos de partículas flotantes */
    .faq-item::after {
      content: '';
      position: absolute;
      top: 20%;
      right: -5px;
      width: 3px;
      height: 3px;
      background: hsl(var(--primary) / 0.3);
      border-radius: 50%;
      opacity: 0;
      animation: floatingParticle 4s infinite;
      animation-delay: calc(var(--item-index, 0) * 0.5s);
    }

    @keyframes floatingParticle {
      0%, 100% {
        opacity: 0;
        transform: translateY(0px) translateX(0px);
      }
      25% {
        opacity: 1;
        transform: translateY(-10px) translateX(5px);
      }
      75% {
        opacity: 0.5;
        transform: translateY(-20px) translateX(-3px);
      }
    }

    /* Efecto de ondas al hacer hover */
    .faq-card::after {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      width: 0;
      height: 0;
      background: radial-gradient(circle, hsl(var(--primary) / 0.1) 0%, transparent 70%);
      border-radius: 50%;
      transform: translate(-50%, -50%);
      transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
      opacity: 0;
      pointer-events: none;
      z-index: -1;
    }

    .faq-card:hover::after {
      width: 300px;
      height: 300px;
      opacity: 1;
    }

    /* Responsive */
    @media (max-width: 768px) {
      .faq-trigger {
        padding: 1rem 1.25rem;
        gap: 3rem;
      }

      .faq-content > div {
        padding: 0.75rem 1.25rem 1.25rem;
      }

      .question-icon {
        transform: scale(0.9);
      }

      /* Reducir efectos en móviles para mejor rendimiento */
      .faq-card::after,
      .faq-item::after {
        display: none;
      }
    }

    /* Reducir animaciones si el usuario lo prefiere */
    @media (prefers-reduced-motion: reduce) {
      .faq-icon,
      .title-reveal {
        animation: none;
        transition: none;
      }

      .faq-content {
        transition: max-height 0.2s ease;
      }
    }
  </style>

  <script is:inline>
    (() => {
      const COMPONENT_ID = "faq-component";

      function initFAQAnimations() {
        const faqSection = document.querySelector('[data-component="faq"]');
        if (!faqSection) return;

        // Inicializar animaciones de entrada
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("show");
                observer.unobserve(entry.target);
              }
            });
          },
          {
            threshold: 0.1,
            rootMargin: "0px 0px -30px 0px",
          }
        );

        faqSection.querySelectorAll(".fade-up").forEach((el) => {
          observer.observe(el);
        });

        // Guardar observer para cleanup
        if (!window.astroObservers) window.astroObservers = {};
        window.astroObservers[COMPONENT_ID] = observer;
      }

      function initFAQFunctionality() {
        const faqTriggers = document.querySelectorAll(".faq-trigger");

        faqTriggers.forEach((trigger) => {
          // Evitar múltiples listeners
          trigger.removeEventListener("click", handleFAQClick);
          trigger.addEventListener("click", handleFAQClick);
        });
      }

      function handleFAQClick() {
        const isExpanded = this.getAttribute("aria-expanded") === "true";
        const content = this.nextElementSibling;
        const icon = this.querySelector(".faq-icon");

        if (isExpanded) {
          // Cerrar
          this.setAttribute("aria-expanded", "false");
          content.style.maxHeight = "0px";
          content.style.opacity = "0";
          if (icon) icon.style.transform = "rotate(0deg)";
        } else {
          // Cerrar otros items
          document.querySelectorAll('.faq-trigger[aria-expanded="true"]').forEach((otherTrigger) => {
            if (otherTrigger !== this) {
              otherTrigger.setAttribute("aria-expanded", "false");
              otherTrigger.nextElementSibling.style.maxHeight = "0px";
              otherTrigger.nextElementSibling.style.opacity = "0";
              const otherIcon = otherTrigger.querySelector(".faq-icon");
              if (otherIcon) otherIcon.style.transform = "rotate(0deg)";
            }
          });

          // Abrir este item
          this.setAttribute("aria-expanded", "true");
          content.style.maxHeight = content.scrollHeight + "px";
          content.style.opacity = "1";
          if (icon) icon.style.transform = "rotate(180deg)";
        }
      }

      function initFAQ() {
        // Limpiar observers previos
        if (window.astroObservers?.[COMPONENT_ID]) {
          window.astroObservers[COMPONENT_ID].disconnect();
        }

        // Reset animaciones
        const faqSection = document.querySelector('[data-component="faq"]');
        if (faqSection) {
          faqSection.querySelectorAll(".fade-up").forEach((el) => {
            el.classList.remove("show");
          });
        }

        // Inicializar después de un breve delay
        setTimeout(() => {
          initFAQAnimations();
          initFAQFunctionality();
        }, 50);
      }

      // Ejecutar cuando el DOM esté listo
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initFAQ);
      } else {
        initFAQ();
      }

      // Para navegación con Astro
      document.addEventListener("astro:page-load", initFAQ);

      // Cleanup antes de cambiar página
      document.addEventListener("astro:before-preparation", () => {
        if (window.astroObservers?.[COMPONENT_ID]) {
          window.astroObservers[COMPONENT_ID].disconnect();
        }
      });
    })();
  </script>
</section>
