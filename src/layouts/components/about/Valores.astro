---
import { getEntry, type CollectionEntry } from "astro:content";
import * as Icons from "lucide-react";
import type { LucideIcon } from "lucide-react";

const { data } = (await getEntry("valores", "valores")) as CollectionEntry<"valores">;
const { title, valores } = data;

const getIcon = (name: string): LucideIcon => (Icons as unknown as Record<string, LucideIcon>)[name] ?? Icons.Sparkles;
---

<section data-component="valores" class="relative isolate overflow-hidden py-24">
  <div class="container relative space-y-12">
    <h2 class="text-center text-3xl md:text-4xl font-extrabold tracking-tight
               fade-up section-title title-reveal">
      {title}
    </h2>

    <dl class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4 values-grid">
      {
        valores.map((v, i) => {
          const Icon = getIcon(v.icon);
          return (
            <div class="value-card fade-up hover-lift floating-card" 
                 style={`--delay:${i * 120}ms; --float-delay:${i * 0.5}s; --card-index:${i}`}>
              <div class="icon-container pulse-glow">
                <Icon className="mx-auto mb-4 h-10 w-10 text-primary icon-float" aria-hidden="true" />
              </div>
              <dt class="mb-3 text-lg font-semibold text-darkmode-light dark:text-darkmode-dark card-title">{v.name}</dt>
              <dd class="text-sm leading-relaxed text-muted-foreground card-description" set:html={v.description} />
              
              <!-- Elementos decorativos -->
              <div class="card-shine"></div>
              <div class="card-glow"></div>
            </div>
          );
        })
      }
    </dl>
  </div>

  <style>
    /* ===== ANIMACIONES CSS PURAS AL CARGAR ===== */
    
    /* Título con reveal effect */
    .title-reveal {
      animation: titleReveal 1.2s cubic-bezier(0.4, 0, 0.2, 1) forwards;
      position: relative;
      overflow: hidden;
    }

    .title-reveal::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, hsl(var(--primary) / 0.3), transparent);
      animation: titleSweep 1.5s ease-out 0.5s;
    }

    @keyframes titleReveal {
      from {
        opacity: 0;
        transform: translateY(50px) scale(0.9);
        filter: blur(10px);
      }
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
        filter: blur(0);
      }
    }

    @keyframes titleSweep {
      from { left: -100%; }
      to { left: 100%; }
    }

    /* Grid con stagger animation */
    .values-grid {
      animation: gridExpand 0.8s ease-out 0.6s both;
    }

    @keyframes gridExpand {
      from {
        opacity: 0;
        transform: scale(0.95);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    /* ===== TARJETAS MEJORADAS ===== */
    .value-card {
      border-radius: 1.5rem;
      padding: 2rem;
      background: hsl(var(--background) / 0.7);
      backdrop-filter: blur(12px);
      border: 1px solid hsl(var(--primary) / 0.15);
      text-align: center;
      position: relative;
      overflow: hidden;
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      animation: cardFloat 4s ease-in-out infinite;
      animation-delay: var(--float-delay);
      box-shadow: 
        0 4px 20px rgba(0, 0, 0, 0.08),
        0 1px 3px rgba(0, 0, 0, 0.05);
    }

    /* Floating animation */
    @keyframes cardFloat {
      0%, 100% {
        transform: translateY(0px) rotate(0deg);
      }
      25% {
        transform: translateY(-5px) rotate(0.5deg);
      }
      75% {
        transform: translateY(-2px) rotate(-0.3deg);
      }
    }

    /* Hover effects */
    .hover-lift {
      cursor: pointer;
    }

    .hover-lift:hover {
      transform: translateY(-12px) scale(1.03) rotate(1deg);
      box-shadow: 
        0 25px 50px rgba(0, 0, 0, 0.15),
        0 0 30px hsl(var(--primary) / 0.4);
      border-color: hsl(var(--primary) / 0.3);
    }

    .hover-lift:hover .card-shine {
      opacity: 1;
      transform: translateX(200%);
    }

    .hover-lift:hover .card-glow {
      opacity: 0.6;
    }

    .hover-lift:hover .icon-float {
      animation: iconBounce 0.6s ease-out;
    }

    /* Elementos decorativos */
    .card-shine {
      position: absolute;
      top: 0;
      left: -100%;
      width: 50%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
      transition: all 0.6s ease;
      opacity: 0;
      pointer-events: none;
    }

    .card-glow {
      position: absolute;
      inset: -2px;
      background: linear-gradient(45deg, 
        hsl(var(--primary) / 0.1), 
        hsl(var(--primary) / 0.05), 
        hsl(var(--primary) / 0.1)
      );
      border-radius: inherit;
      opacity: 0;
      transition: opacity 0.4s ease;
      pointer-events: none;
      z-index: -1;
    }

    /* ===== ICONOS ANIMADOS ===== */
    .icon-container {
      position: relative;
      display: inline-block;
    }

    .pulse-glow {
      animation: pulseGlow 3s ease-in-out infinite;
    }

    @keyframes pulseGlow {
      0%, 100% {
        filter: drop-shadow(0 0 5px hsl(var(--primary) / 0.3));
      }
      50% {
        filter: drop-shadow(0 0 15px hsl(var(--primary) / 0.6));
      }
    }

    .icon-float {
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    @keyframes iconBounce {
      0%, 100% { transform: translateY(0) scale(1); }
      25% { transform: translateY(-5px) scale(1.1); }
      75% { transform: translateY(-2px) scale(1.05); }
    }

    /* ===== TEXTO ANIMADO ===== */
    .card-title {
      transition: all 0.3s ease;
      position: relative;
    }

    .value-card:hover .card-title {
      color: hsl(var(--primary));
      transform: scale(1.05);
    }

    .card-description {
      transition: all 0.3s ease;
      line-height: 1.6;
    }

    .value-card:hover .card-description {
      color: hsl(var(--darkmode-light));
    }

    /* ===== ANIMACIONES CON VIEW TRANSITIONS ===== */
    @supports (animation-timeline: view()) {
      .section-title {
        animation: titleSlideView linear forwards;
        animation-timeline: view();
        animation-range: entry 0% entry 30%;
      }

      .value-card {
        animation: cardSlideView linear forwards, cardFloat 4s ease-in-out infinite;
        animation-timeline: view(), auto;
        animation-range: entry 0% entry 40%;
        animation-delay: calc(var(--card-index) * 0.1s), var(--float-delay);
      }

      @keyframes titleSlideView {
        from {
          opacity: 0;
          transform: translateY(80px) scale(0.8);
        }
        to {
          opacity: 1;
          transform: translateY(0) scale(1);
        }
      }

      @keyframes cardSlideView {
        from {
          opacity: 0;
          transform: translateY(60px) scale(0.9) rotate(-5deg);
        }
        to {
          opacity: 1;
          transform: translateY(0) scale(1) rotate(0deg);
        }
      }
    }

    /* ===== PLAN B - Animaciones JS ===== */
    .fade-up {
      opacity: 1;
    }

    @media (prefers-reduced-motion: no-preference) {
      .fade-up {
        opacity: 0;
        transform: translateY(24px);
      }
    }

    .fade-up.show {
      opacity: 1;
      transform: none;
      transition:
        opacity 0.6s ease-out,
        transform 0.6s ease-out;
      transition-delay: var(--delay, 0ms);
    }

    /* Fallback para navegadores sin soporte */
    @supports not (animation-timeline: view()) {
      .fade-up {
        opacity: 1;
      }
    }

    /* ===== EFECTOS ADICIONALES ===== */
    
    /* Efecto ripple al hacer click */
    .value-card {
      position: relative;
      overflow: hidden;
    }

    .value-card::after {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      width: 0;
      height: 0;
      background: hsl(var(--primary) / 0.1);
      border-radius: 50%;
      transform: translate(-50%, -50%);
      transition: width 0.6s ease, height 0.6s ease;
      pointer-events: none;
    }

    .value-card:active::after {
      width: 300px;
      height: 300px;
    }

    /* Responsive */
    @media (max-width: 768px) {
      .value-card {
        animation-duration: 6s; /* Slower float on mobile */
      }
      
      .hover-lift:hover {
        transform: translateY(-6px) scale(1.02);
      }
      
      .cardFloat {
        animation-duration: 5s;
      }
    }

    /* Reducir animaciones si el usuario lo prefiere */
    @media (prefers-reduced-motion: reduce) {
      .value-card,
      .pulse-glow,
      .title-reveal {
        animation: none;
      }
      
      .hover-lift:hover {
        transform: translateY(-4px);
      }
    }
  </style>

  <script is:inline>
    (() => {
      const COMPONENT_ID = 'valores-animations';
      
      function resetAnimations() {
        const section = document.querySelector('section[data-component="valores"]');
        if (!section) return;
        
        const elements = section.querySelectorAll(".fade-up");
        elements.forEach(el => {
          el.classList.remove("show");
        });
      }

      function initAnimations() {
        const section = document.querySelector('section[data-component="valores"]');
        if (!section) return;

        const io = new IntersectionObserver(
          (e) =>
            e.forEach((x) => {
              if (x.isIntersecting) {
                x.target.classList.add("show");
                
                // Agregar efecto de onda para las tarjetas
                if (x.target.classList.contains('value-card')) {
                  setTimeout(() => {
                    x.target.style.animation += ', rippleEffect 0.8s ease-out';
                  }, 300);
                }
                
                io.unobserve(x.target);
              }
            }),
          { 
            threshold: 0.2,
            rootMargin: '0px 0px -30px 0px'
          }
        );
        
        section.querySelectorAll(".fade-up").forEach((el) => io.observe(el));
        
        if (!window.astroObservers) window.astroObservers = {};
        window.astroObservers[COMPONENT_ID] = io;
      }

      function setupAnimations() {
        if (window.astroObservers?.[COMPONENT_ID]) {
          window.astroObservers[COMPONENT_ID].disconnect();
        }
        resetAnimations();
        setTimeout(() => initAnimations(), 50);
      }

      if (document.querySelector('section[data-component="valores"]')) {
        setupAnimations();

        if (!window.astroListenersAdded) {
          window.astroListenersAdded = new Set();
        }

        if (!window.astroListenersAdded.has(COMPONENT_ID)) {
          const handlePageLoad = () => {
            if (document.querySelector('section[data-component="valores"]')) {
              setupAnimations();
            }
          };

          const handleBeforePreparation = () => {
            if (window.astroObservers?.[COMPONENT_ID]) {
              window.astroObservers[COMPONENT_ID].disconnect();
            }
          };

          document.addEventListener('astro:page-load', handlePageLoad);
          document.addEventListener('astro:before-preparation', handleBeforePreparation);
          
          window.astroListenersAdded.add(COMPONENT_ID);
        }
      }

      // Agregar keyframe para ripple effect dinámicamente
      const style = document.createElement('style');
      style.textContent = `
        @keyframes rippleEffect {
          0% {
            box-shadow: 0 0 0 0 hsl(var(--primary) / 0.3);
          }
          100% {
            box-shadow: 0 0 0 20px hsl(var(--primary) / 0);
          }
        }
      `;
      document.head.appendChild(style);
    })();
  </script>
</section>