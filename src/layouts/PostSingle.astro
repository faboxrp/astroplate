---
import BlogCard from "@/components/BlogCard.astro";
import Share from "@/components/Share.astro";
// import Disqus from "@/helpers/Disqus"; // Comentado o eliminado si no se usa Disqus
import { getSinglePage } from "@/lib/contentParser.astro";
import dateFormat from "@/lib/utils/dateFormat";
import similarItems from "@/lib/utils/similarItems";
import { humanize, markdownify, slugify } from "@/lib/utils/textConverter";
import { render } from "astro:content";
import { FaRegClock, FaRegFolder, FaRegUserCircle } from "react-icons/fa";
import ImageMod from "@/components/ImageMod.astro"; // Corregido: ImageMod es un componente, no está en layouts

const COLLECTION_FOLDER = "blog";
const { post } = Astro.props;

const posts = await getSinglePage(COLLECTION_FOLDER);
const similarPosts = similarItems(post, posts);
const { Content } = await render(post); // render() es para Astro < 3.0, para Astro 3.0+ es post.render()
// Para Astro 3.0+
// const { Content, headings } = await post.render();

const { title, description, author, categories, image, date, tags } = post.data;

// Definir el nombre del autor principal para el blog
const mainAuthorName = "Dra. Paola Mafla Rosero";
const authorDisplayName = author === "Admin" || !author ? mainAuthorName : humanize(author); // Si el autor es "Admin" o no está definido, usa mainAuthorName
const authorSlug = author === "Admin" || !author ? slugify(mainAuthorName) : slugify(author);
---

<section class="section pt-7">
  <div class="container">
    <div class="row justify-center">
      <article class="lg:col-10">
        {
          image && (
            <div class="mb-10">
              <ImageMod src={image} height={500} width={1200} alt={title} class="w-full rounded" format="webp" />
            </div>
          )
        }
        <h1 set:html={markdownify(title)} class="h2 mb-4" />
        <ul class="mb-4">
          <li class="mr-4 inline-block">
            {/* Enlace al autor. Si solo hay uno, podría no ser un enlace o enlazar a la página "Nosotros" */}
            <a href={`/autores/${authorSlug}`}>
              <FaRegUserCircle className={"mr-2 -mt-1 inline-block"} />
              {authorDisplayName}
            </a>
          </li>
          <li class="mr-4 inline-block">
            <FaRegFolder className={"mr-2 -mt-1 inline-block"} />
            {
              categories.map((category: string, index: number) => (
                <a href={`/categories/${slugify(category)}`} class="hover:text-primary">
                  {humanize(category)}
                  {index !== categories.length - 1 && ", "}
                </a>
              ))
            }
          </li>
          {
            date && ( // Mostrar fecha solo si está definida
              <li class="mr-4 inline-block">
                <FaRegClock className={"mr-2 -mt-1 inline-block"} />
                {dateFormat(date)}
              </li>
            )
          }
        </ul>
        <div class="content mb-10 prose dark:prose-invert max-w-none sm:prose-lg">
          {/* Aplicar clases de prose para el contenido del blog */}
          <Content />
        </div>
        <div class="row items-start justify-between">
          {
            tags &&
              tags.length > 0 &&
              tags[0] !== "others" && ( // Mostrar tags solo si existen y no son solo "others"
                <div class="mb-10 flex items-center lg:col-5 lg:mb-0">
                  <h5 class="mr-3">Etiquetas:</h5>
                  <ul>
                    {tags.map((tag: string) => (
                      <li class="inline-block">
                        <a
                          class="m-1 block rounded bg-light px-3 py-1 hover:bg-primary hover:text-white dark:bg-darkmode-light dark:hover:bg-darkmode-primary dark:hover:text-white"
                          href={`/tags/${slugify(tag)}`}>
                          {humanize(tag)}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )
          }
          <div class={`flex items-center ${tags && tags.length > 0 && tags[0] !== "others" ? "lg:col-4 lg:ml-auto" : "w-full justify-start"}`}>
            {/* Ajustar si los tags no están */}
            <h5 class="mr-3">Compartir:</h5>
            <Share className="social-icons" title={title} description={description} slug={post.slug} />
          </div>
        </div>

        {/* Disqus - Considerar si es necesario para un blog de consultorio */}
        {/* <Disqus className="mt-20" client:load /> */}
      </article>
    </div>

    {/* Related posts */}
    {
      similarPosts && similarPosts.length > 0 && (
        <div class="section pb-0">
          <h2 class="h3 mb-12 text-center">Artículos Relacionados</h2>
          <div class="row justify-center">
            {similarPosts.map(
              (
                relatedPost // Cambiado 'post' a 'relatedPost' para evitar colisión de nombres
              ) => (
                <div class="lg:col-4 md:col-6 mb-14">
                  <BlogCard data={relatedPost} />
                </div>
              )
            )}
          </div>
        </div>
      )
    }
  </div>
</section>
