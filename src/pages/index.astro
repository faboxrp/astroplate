---
import ImageMod from "@/components/ImageMod.astro";
import TeamSlider from "@/components/TeamSlider.tsx";
import Base from "@/layouts/Base.astro";
import { markdownify } from "@/lib/utils/textConverter";
import CallToAction from "@/partials/CallToAction.astro";
import Testimonial from "@/partials/Testimonial.astro";
import FAQ from "@/components/FAQ.astro";
import type { Button, Feature } from "@/types";
import type { CollectionEntry } from "astro:content";
import { getEntry, getCollection } from "astro:content";
import { FaCheck } from "react-icons/fa";

// Import additional components for full single-page experience
import Story from "@/layouts/components/about/Story.astro";
import Valores from "@/layouts/components/about/Valores.astro";
import InformacionContacto from "@/layouts/components/contacto/InformacionContacto.astro";
import FormularioContacto from "@/layouts/components/contacto/FormularioContacto.astro";
import ServiceItem from "@/layouts/components/services/ServiceItem.astro";
import BlogCard from "@/layouts/components/BlogCard.astro";
import { sortByOrder } from "@/lib/utils/sortFunctions";
import config from "@/config/config.json";

interface Homepage {
  banner: {
    title: string;
    content: string;
    image: string;
    button: Button;
  };
  features: Feature[];
  team?: {
    doctors: Array<{
      name: string;
      id: string;
      images: string[];
      main_image: string;
      active: boolean;
    }>;
  };
}

const homepage = (await getEntry("homepage", "-index")) as CollectionEntry<"homepage">;

const testimonial = (await getEntry("testimonialSection", "testimonial")) as CollectionEntry<"testimonialSection">;

const call_to_action = (await getEntry("ctaSection", "call-to-action")) as CollectionEntry<"ctaSection">;

// Additional content for single-page experience
const about = (await getEntry("about", "-index")) as CollectionEntry<"about">;
const contactPageData = await getEntry("contact", "-index");
const servicesPageInfo = (await getEntry("servicesIndex", "-index"));
const allServicesUnfiltered = await getCollection("servicios");
const allServices = allServicesUnfiltered.filter((entry) => entry.data.draft !== true);
const sortedServices = sortByOrder(allServices);

// Blog posts for mobile section
const allBlogPosts = await getCollection("blog");
const publishedPosts = allBlogPosts.filter((post) => !post.data.draft);
const sortedPosts = publishedPosts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()).slice(0, 6);

const { banner, features, team } = homepage.data as Homepage;
const { contact_form_action } = config.params;

// Get active doctor for team slider
const activeDoctor = team?.doctors?.find(doctor => doctor.active) || team?.doctors?.[0];
---

<Base>
  <!-- Banner -->
  <section class="pt-14 pb-4 md:pb-8 xl:pb-12 bg-pattern-mosaico-banner">
    <div class="container">
      <div class="row justify-center">
        <div class="lg:col-8 md:col-10 mb-8 text-center">
          {/* Hero Badge */}
          <div class="inline-block px-6 py-3 bg-gradient-to-r from-primary/20 to-secondary/20 rounded-full mb-6 dark:bg-darkmode-secondary">
            <span class="text-primary dark:text-darkmode-text-light font-semibold text-sm uppercase tracking-wider"
              >✨ OrthoPure - Especialistas en Sonrisas</span
            >
          </div>

          {/* Main Title */}
          <h1 set:html={markdownify(banner.title)} class="mb-6 text-h3 lg:text-h1 text-primary leading-tight dark:text-darkmode-primary font-bold" />

          {/* Enhanced Description */}
          <div class="mb-8 max-w-3xl mx-auto">
            <p
              set:html={markdownify(banner.content)}
              class="text-xl lg:text-2xl text-primary dark:text-darkmode-secondary bg-white/90 backdrop-blur-sm rounded-2xl px-8 py-6 shadow-lg border border-primary/10 leading-relaxed"
            />
          </div>

          {/* Enhanced Image Container with CTA Button */}
          <div class="bg-white/90 backdrop-blur-sm rounded-3xl p-6 md:p-10 shadow-2xl border border-primary/10 hover:shadow-3xl transition-all duration-500">
            {
              banner.image && (
                <div class="col-12">
                  <div class="relative overflow-hidden rounded-2xl mb-8">
                    <ImageMod
                      src={banner.image}
                      height={400}
                      width={900}
                      alt="OrthoPure - Transformamos sonrisas"
                      format="webp"
                      loading="eager"
                      class="rounded-2xl w-full h-auto"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-primary/10 via-transparent to-transparent rounded-2xl" />
                  </div>

                  {/* CTA Button Inside Card */}
                  {banner.button.enable && (
                    <div class="text-center">
                      <a
                        class="btn btn-primary btn-lg px-10 py-4 text-lg font-semibold shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105"
                        href={banner.button.link}
                        target={banner.button.link.startsWith("http") ? "_blank" : "_self"}
                        rel="noopener">
                        {banner.button.label}
                      </a>
                      <p class="text-sm text-gray-600 mt-3 font-medium">📞 Consulta gratuita • 💯 Resultados garantizados</p>
                    </div>
                  )}
                </div>
              )
            }
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- /Banner -->

  <!-- Features -->
  {/* Specialty Services - Enhanced Vertical Stack Layout */}
  <section class="section bg-pattern-mosaico">
    <div class="container">
      {/* Section Header */}
      <div class="text-center mb-16">
        <div class="inline-block px-4 py-2 bg-primary/10 dark:bg-darkmode-secondary rounded-full mb-4">
          <span class="text-primary dark:text-darkmode-text font-medium text-sm uppercase tracking-wider">Especialidades</span>
        </div>
        <h2 class="mb-6 text-h2 text-primary leading-tight dark:text-darkmode-secondary font-bold">
          Nuestra Especialidad:<br />
          <span class="text-secondary dark:text-darkmode-primary">Ortodoncia y Ortopedia Maxilar</span>
        </h2>
        <p class="text-xl text-gray-600 dark:text-darkmode-text-light max-w-2xl mx-auto font-light leading-relaxed">
          Soluciones <strong class="text-primary font-semibold">personalizadas</strong> adaptadas a cada etapa de la vida, con un enfoque <strong
            class="text-primary font-semibold">humano y profesional</strong
          >
        </p>
      </div>

      {/* Specialty Items */}
      <div class="space-y-16 max-w-4xl mx-auto">
        {
          features.slice(0, 3).map((feature, index: number) => (
            <div class="group">
              {/* Content Card with Image Inside */}
              <div class="bg-white/90 backdrop-blur-sm rounded-2xl p-8 md:p-10 shadow-lg hover:shadow-xl transition-all duration-500 border border-primary/10">
                <div class="text-center">
                  {/* Specialty Badge */}
                  <div class="inline-flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-primary/20 to-secondary/20 rounded-full mb-4">
                    <div class="w-2 h-2 bg-primary rounded-full" />
                    <span class="text-primary font-semibold text-sm uppercase tracking-wide">
                      {index === 0 ? "Para Niños" : index === 1 ? "Para Adolescentes" : "Para Adultos"}
                    </span>
                  </div>

                  {/* Title */}
                  <h3 set:html={markdownify(feature.title)} class="mb-6 text-3xl md:text-4xl font-bold text-primary leading-tight" />

                  {/* Description */}
                  <div class="max-w-3xl mx-auto mb-6">
                    <p set:html={markdownify(feature.content)} class="text-xl md:text-2xl text-gray-700 leading-relaxed font-light" />
                  </div>

                  {/* Call to Action Text - Before Image */}
                  <div class="p-4 bg-gradient-to-r from-primary/5 to-secondary/5 rounded-xl border-l-4 border-primary mb-8">
                    <p class="text-primary font-medium text-lg italic">
                      {index === 0
                        ? "💙 Corregir a tiempo es amar a tus hijos, agenda tu cita ahora!"
                        : index === 1
                          ? "✨ Una sonrisa perfecta para brillar con confianza"
                          : "🌟 Nunca es tarde para transformar tu vida con una sonrisa radiante"}
                    </p>
                  </div>

                  {/* Image Inside Card */}
                  <div class="flex justify-center group-hover:scale-[1.02] transition-transform duration-500">
                    <div class="relative overflow-hidden rounded-xl shadow-lg">
                      <ImageMod src={feature.image} height={400} width={600} alt={feature.title} format="webp" class="rounded-xl" />
                      <div class="absolute inset-0 bg-gradient-to-t from-black/10 via-transparent to-transparent rounded-xl" />
                    </div>
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>

      {/* Bottom Call to Action */}
      <div class="text-center mt-16">
        <div class="bg-white/80 backdrop-blur-sm rounded-2xl p-8 shadow-lg border border-primary/20 max-w-2xl mx-auto">
          <h4 class="text-2xl font-bold text-primary mb-4">¿Listo para transformar tu sonrisa?</h4>
          <p class="text-gray-600 mb-6">Agenda tu consulta personalizada y descubre el tratamiento perfecto para ti</p>
          <a href="/contacto" class="btn btn-primary btn-lg px-8 py-4 text-lg" data-astro-reload> 🦷 Agenda tu Cita Gratuita </a>
        </div>
      </div>
    </div>
  </section>

  {/* Enhanced Remaining Features */}
  {
    features.slice(3).map((feature, index: number) => (
      <section class={`section-sm ${index % 2 !== 0 ? "bg-pattern-mosaico" : ""}`}>
        <div class="container">
          <div class="max-w-6xl mx-auto">
            {/* Enhanced Feature Card */}
            <div class="bg-white/90 backdrop-blur-sm rounded-3xl p-8 md:p-12 shadow-2xl border border-primary/10 hover:shadow-3xl transition-all duration-500">
              {/* Mobile Layout: Title -> Image -> Content */}
              <div class="block md:hidden">
                {/* Feature Badge */}
                <div class="inline-block px-4 py-2 bg-gradient-to-r from-primary/15 to-secondary/15 rounded-full mb-6">
                  <span class="text-primary font-semibold text-sm uppercase tracking-wide">{index === 0 ? "👩‍⚕️ Nuestro Equipo" : "🌟 Nuestros Resultados"}</span>
                </div>

                {/* Title */}
                <h2 set:html={markdownify(feature.title)} class="mb-8 text-3xl font-bold text-primary leading-tight text-center" />

                {/* Image for mobile - After Title */}
                <div class="mb-8 flex justify-center">
                  {index === 0 ? (
                    <!-- Team Image Slider for Mobile with React + Swiper -->
                    <div class="relative overflow-hidden rounded-2xl shadow-lg group max-w-md">
                      <TeamSlider
                        client:load
                        images={activeDoctor?.images || [feature.image]}
                        alt={activeDoctor?.name || feature.title}
                        doctorName={activeDoctor?.name}
                        height={400}
                        interval={4000}
                        className="group-hover:scale-105 transition-transform duration-500"
                      />
                    </div>
                  ) : (
                    <!-- Regular Image for other sections on Mobile -->
                    <div class="relative overflow-hidden rounded-2xl shadow-lg group max-w-md">
                      <ImageMod
                        src={feature.image}
                        height={400}
                        width={400}
                        alt={feature.title}
                        format="webp"
                        class="rounded-2xl group-hover:scale-105 transition-transform duration-500"
                      />
                      <div class="absolute inset-0 bg-gradient-to-t from-primary/10 via-transparent to-transparent rounded-2xl" />
                    </div>
                  )}
                </div>

                {/* Content - After Image */}
                <p set:html={markdownify(feature.content)} class="mb-8 text-xl text-gray-700 dark:text-darkmode-secondary leading-relaxed font-light text-center" />

                {/* Enhanced Bullet Points */}
                <div class="mb-8">
                  <ul class="space-y-4">
                    {feature.bulletpoints.map((bullet: string) => (
                      <li class="relative pl-8 py-2">
                        <div class="absolute left-0 top-3 w-2 h-2 bg-primary rounded-full" />
                        <div class="bg-gradient-to-r from-primary/5 to-transparent p-4 rounded-xl border-l-2 border-primary/30">
                          <span set:html={markdownify(bullet)} class=" dark:text-darkmode-light font-medium" />
                        </div>
                      </li>
                    ))}
                  </ul>
                </div>

                {/* Enhanced CTA */}
                {feature.button.enable && (
                  <div class="text-center">
                    <a
                      class="btn btn-primary btn-lg px-8 py-4 text-lg font-semibold shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105 md:hidden"
                      href="#nosotros">
                      {feature.button.label}
                    </a>
                    <a
                      class="btn btn-primary btn-lg px-8 py-4 text-lg font-semibold shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105 hidden md:inline-block"
                      href={feature.button.link}>
                      {feature.button.label}
                    </a>
                    {index === 0 && <p class="text-sm text-gray-600 mt-3 font-medium">💼 Experiencia profesional • 🎓 Formación especializada</p>}
                    {index === 1 && <p class="text-sm text-gray-600 mt-3 font-medium">📸 Casos reales • ✨ Transformaciones increíbles</p>}
                  </div>
                )}
              </div>

              {/* Desktop Layout: Side by Side */}
              <div class="hidden md:block">
                <div class="row items-center justify-between">
                  <div class={`md:col-7 lg:col-6 ${index % 2 !== 0 && "md:order-1"}`}>
                    {/* Feature Badge */}
                    <div class="inline-block px-4 py-2 bg-gradient-to-r from-primary/15 to-secondary/15 rounded-full mb-6">
                      <span class="text-primary font-semibold text-sm uppercase tracking-wide">
                        {index === 0 ? "👩‍⚕️ Nuestro Equipo" : "🌟 Nuestros Resultados"}
                      </span>
                    </div>

                    <h2 set:html={markdownify(feature.title)} class="mb-6 text-3xl lg:text-4xl font-bold text-primary dark:text-darkmode-primary leading-tight" />
                    <p set:html={markdownify(feature.content)} class="mb-8 text-xl text-gray-700 dark:text-gray-300 leading-relaxed font-light" />

                    {/* Enhanced Bullet Points */}
                    <div class="mb-8">
                      <ul class="space-y-4">
                        {feature.bulletpoints.map((bullet: string) => (
                          <li class="relative pl-8 py-2">
                            <div class="absolute left-0 top-3 w-2 h-2 bg-primary rounded-full" />
                            <div class="bg-gradient-to-r from-primary/5 to-transparent p-4 rounded-xl border-l-2 border-primary/30">
                              <span set:html={markdownify(bullet)} class="text-gray-700 dark:text-gray-300 font-medium" />
                            </div>
                          </li>
                        ))}
                      </ul>
                    </div>

                    {/* Enhanced CTA */}
                    {feature.button.enable && (
                      <div class="text-center md:text-left">
                        <a
                          class="btn btn-primary btn-lg px-8 py-4 text-lg font-semibold shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105 md:hidden"
                          href="#nosotros">
                          {feature.button.label}
                        </a>
                        <a
                          class="btn btn-primary btn-lg px-8 py-4 text-lg font-semibold shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105 hidden md:inline-block"
                          href={feature.button.link}>
                          {feature.button.label}
                        </a>
                        {index === 0 && <p class="text-sm text-gray-600 mt-3 font-medium">💼 Experiencia profesional • 🎓 Formación especializada</p>}
                        {index === 1 && <p class="text-sm text-gray-600 mt-3 font-medium">📸 Casos reales • ✨ Transformaciones increíbles</p>}
                      </div>
                    )}
                  </div>

                  <div class={`md:col-5 ${index % 2 !== 0 && "md:order-2"}`}>
                    {index === 0 ? (
                      <!-- Team Image Slider with React + Swiper -->
                      <div class="relative overflow-hidden rounded-2xl shadow-lg group">
                        <TeamSlider
                          client:load
                          images={activeDoctor?.images || [feature.image]}
                          alt={activeDoctor?.name || feature.title}
                          doctorName={activeDoctor?.name}
                          height={500}
                          interval={4000}
                          className="group-hover:scale-105 transition-transform duration-500"
                        />
                      </div>
                    ) : (
                      <!-- Regular Image for other sections -->
                      <div class="relative overflow-hidden rounded-2xl shadow-lg group">
                        <ImageMod
                          src={feature.image}
                          height={500}
                          width={550}
                          alt={feature.title}
                          format="webp"
                          class="rounded-2xl group-hover:scale-105 transition-transform duration-500"
                        />
                        <div class="absolute inset-0 bg-gradient-to-t from-primary/10 via-transparent to-transparent rounded-2xl" />
                      </div>
                    )}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    ))
  }
  <!-- /Features -->

  <FAQ />
  
  <!-- Mobile Single-Page Sections (Hidden on Desktop) -->
  <div class="block md:hidden">
    <!-- About/Nosotros Section -->
    <section id="nosotros" class="section bg-gradient-to-br from-primary/5 to-secondary/5">
      <div class="container">
        <div class="text-center mb-12">
          <h2 class="h2 mb-4 font-bold text-primary dark:text-darkmode-primary">Nosotros</h2>
          <p class="text-lg text-gray-600 dark:text-darkmode-light">Conoce nuestro equipo y valores</p>
        </div>
        <Story className="fade-up opacity-100 motion-safe:opacity-0" />
        <Valores />
      </div>
    </section>

    <!-- Services Section -->
    <section id="servicios" class="section bg-pattern-mosaico-banner">
      <div class="container">
        <div class="text-center mb-12">
          <h2 class="h2 mb-4 font-bold text-primary dark:text-darkmode-primary">Servicios</h2>
          <p class="text-lg dark:text-darkmode-primary">Descubre nuestros tratamientos especializados</p>
        </div>
        <div class="rounded-2xl bg-white/80 backdrop-blur-sm shadow-lg p-6 md:p-10 border border-primary/10">
          {
            sortedServices.length > 0 ? (
              sortedServices.map((service, index) => (
                <ServiceItem service={service} index={index} />
              ))
            ) : (
              <div class="text-center py-12">
                <p class="text-lg dark:text-darkmode-primary">
                  Próximamente encontrarás aquí información detallada sobre nuestros servicios.
                  <br />
                  ¡Gracias por tu paciencia!
                </p>
              </div>
            )
          }
        </div>
      </div>
    </section>

    <!-- Blog Section -->
    <section id="blog" class="section bg-pattern-mosaico">
      <div class="container">
        <div class="text-center mb-12">
          <h2 class="h2 mb-4 font-bold text-primary dark:text-darkmode-primary">Blog OrthoPure: Consejos y Cuidados para tu Sonrisa</h2>
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {
            sortedPosts.map((post) => (
              <BlogCard data={post} />
            ))
          }
        </div>
        <div class="text-center mt-8">
          <a href="/blog" class="btn btn-outline-primary">
            Ver todos los artículos
          </a>
        </div>
      </div>
    </section>

    <!-- Contact Section -->
    <section id="contacto" class="section bg-gradient-to-br from-primary/5 to-secondary/5">
      <div class="container">
        <div class="text-center mb-12">
          <h2 class="h2 mb-4 font-bold text-primary dark:text-darkmode-primary">Contáctanos</h2>
        </div>
        <div class="space-y-12">
          {contactPageData && <InformacionContacto data={contactPageData.data} />}
          <div class="flex justify-center">
            <FormularioContacto action={contact_form_action} />
          </div>
        </div>
      </div>
    </section>
  </div>
  
  <!-- TEMPORALMENTE COMENTADO - Testimonios (Ver TEMPORARY_CHANGES.md) -->
  <!-- <Testimonial class="bg-pattern-mosaico" testimonial={testimonial} /> -->
  <CallToAction call_to_action={call_to_action} />
</Base>
