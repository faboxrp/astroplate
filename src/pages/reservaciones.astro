---
// Importaciones
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import PageHeader from "@/partials/PageHeader.astro";
import { getEntry } from "astro:content";
import UbicacionesReservaciones from "@/layouts/components/reservaciones/UbicacionesReservaciones.astro";
import CallToAction from "@/partials/CallToAction.astro";

// Lógica para obtener datos
const contactPageData = await getEntry("contact", "-index");

if (!contactPageData) {
  return Astro.redirect("/404");
}

const call_to_action = await getEntry("ctaSection", "call-to-action");
const { meta_title, description, image } = contactPageData.data;

// Datos específicos para reservaciones
const title = "Reservaciones";
const intro_text = "Agenda tu cita en cualquiera de nuestras ubicaciones, Ibarra y Tulcán.";
---

<Base title={title} meta_title={meta_title} description={description} image={image}>
  <div class="bg-pattern-mosaico">
    <PageHeader title={title} intro={intro_text} />
    <section class="pb-14">
      <div class="container">
        <UbicacionesReservaciones data={contactPageData.data} />
      </div>
    </section>
    <CallToAction call_to_action={call_to_action} />
  </div>
</Base>
