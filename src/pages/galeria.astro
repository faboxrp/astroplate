---
import { getCollection, getEntry } from "astro:content";
import Base from "@/layouts/Base.astro"; // Tu layout base
import PageHeader from "@/layouts/partials/PageHeader.astro"; // Si usas un cabecero de página
import { Image } from "astro:assets"; // Para optimización de imágenes
import { render } from "astro:content";

// Obtener la entrada específica para la página de galería (asumiendo que es -index)
// O usa getCollection si tienes múltiples archivos/entradas en la colección 'galeria'
const galleryPageEntry = await getEntry("galeria", "-index"); // Usamos el slug '-index'

if (!galleryPageEntry) {
  // Manejar el caso en que la entrada no se encuentre
  return new Response(null, { status: 404, statusText: "Galería no encontrada" });
}

const { Content } = await render(galleryPageEntry);

const { title, meta_title, description, header_image, gallery_items } = galleryPageEntry.data;
---

<Base title={title} meta_title={meta_title} description={description} image={header_image}>
  <PageHeader title={title} image={header_image} />

  <section class="section-sm">
    <div class="container">
      <div class="content mb-8 prose dark:prose-invert max-w-none">
        <Content />
      </div>

      {
        gallery_items && gallery_items.length > 0 ? (
          <div class="gallery-grid">
            {gallery_items.map((item: { image_url: string; alt_text: string; caption?: string }) => (
              <div class="gallery-item">
                <a href={item.image_url} target="_blank" rel="noopener noreferrer">
                  <Image src={item.image_url} alt={item.alt_text} width={600} height={400} format="webp" quality={80} class="img-responsive" />
                </a>
                {item.caption && <p class="caption-text">{item.caption}</p>} {/* O 'text-sm text-center mt-1' */}
              </div>
            ))}
          </div>
        ) : (
          <p>No hay imágenes en la galería actualmente.</p>
        )
      }
    </div>
  </section>
</Base>

<style>
  /* Estilos específicos para la galería, pueden ir aquí o en un archivo CSS importado */
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1rem; /* 16px */
  }
  .gallery-item .img-responsive {
    width: 100%;
    height: auto;
    border-radius: 0.375rem; /* rounded-md */
    box-shadow:
      0 1px 3px 0 rgb(0 0 0 / 0.1),
      0 1px 2px -1px rgb(0 0 0 / 0.1); /* shadow-sm */
  }
  .gallery-item .caption-text {
    font-size: 0.875rem; /* text-sm */
    text-align: center;
    margin-top: 0.25rem; /* mt-1 */
    color: #555; /* Un color de ejemplo */
  }
  .dark .gallery-item .caption-text {
    color: #bbb; /* Color de ejemplo para modo oscuro */
  }
</style>
