---
// Importaciones
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import PageHeader from "@/partials/PageHeader.astro";
import { getEntry } from "astro:content";
import { markdownify } from "@/lib/utils/textConverter";
import InformacionContacto from "@/layouts/components/contacto/InformacionContacto.astro";
import FormularioContacto from "@/layouts/components/contacto/FormularioContacto.astro";
import CallToAction from "@/partials/CallToAction.astro";

// Lógica para obtener datos
const contactPageData = await getEntry("contact", "-index");

if (!contactPageData) {
  return Astro.redirect('/404');
}

const call_to_action = await getEntry("ctaSection", "call-to-action");
const { title, meta_title, description, image, intro_text } = contactPageData.data;
const { contact_form_action } = config.params;
---

<Base title={title} meta_title={meta_title} description={description} image={image}>
  <div class="bg-pattern-mosaico">
    <PageHeader title={title} intro={intro_text} />
    <section class="section-sm">
      <div class="container">
        <div class="space-y-12">
          {/* Información de contacto */}
          <div>
            <InformacionContacto data={contactPageData.data} />
          </div>

          {/* Formulario de contacto */}
          <div class="flex justify-center">
            <FormularioContacto action={contact_form_action} />
          </div>
        </div>
      </div>
    </section>
    <CallToAction call_to_action={call_to_action} />
  </div>
</Base>
